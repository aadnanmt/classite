---
import { Font } from 'astro:assets'
import '../styles/global.css'
import BaseHead from '../components/core/BaseHead.astro'
import Navbar from '../components/core/Navbar.astro'
import Footer from '../components/core/Footer.astro'
import Container from '../components/ui/Container.astro'
import type { PageProps } from '../types'

const { title, description } = Astro.props as PageProps
---

<!doctype html>
<html lang="id">
  <head>
    <BaseHead title={title} description={description} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <!-- htmx 2.0.10 -->
    <script is:inline src="/htmx.min.js"></script>
  </head>
  <body class="bg-cream flex min-h-screen flex-col font-sans text-black antialiased">
    <Navbar />

    <main class="grow py-8">
      <Container>
        <slot />
      </Container>
    </main>

    <Footer />
  </body>
</html>
