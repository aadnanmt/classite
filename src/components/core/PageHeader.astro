---
interface Props {
  title: string
  highlight?: string
  after?: string
  description?: string
  size?: 'page' | 'hero' | 'display'
}

const { title, highlight, after, description, size = 'page' } = Astro.props

const sizeMap = {
  page: { text: 'text-page', pad: 'py-16 md:py-24' },
  hero: { text: 'text-hero', pad: 'py-16 md:py-24' },
  display: { text: 'text-display', pad: 'py-24 md:py-32' },
}
---

<section class:list={['text-center', sizeMap[size].pad]}>
  <h1 class={`${sizeMap[size].text} font-black leading-none tracking-tight`}>
    {title}{
      highlight && (
        <span class="relative">
          <>
            <span class="bg-accent absolute inset-x-0 bottom-0 h-[50%]" />
            <span class="relative">{highlight}</span>
          </>
        </span>
      )
    }{after}
  </h1>
  {description && <p class="mx-auto mt-4 max-w-xl text-lg text-gray-700">{description}</p>}
  <slot />
</section>
