---
const links = [
  { label: 'Dashboard', href: '/' },
  { label: 'Jadwal', href: '/' },
  { label: 'Galeri', href: '/' },
  { label: 'Pesan', href: '/' },
]
---

<nav class="border-b-3 border-black bg-white">
  <div class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="/" class="text-xl font-black tracking-tight">FOURFO</a>

    <div class="flex items-center">
      {
        links.map((link) => (
          <a href={link.href} class="px-4 text-sm font-medium">
            <span class="underline-grow">{link.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</nav>
