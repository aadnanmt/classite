---
import type { BrutalVariant } from '../../types'

interface Props {
  href: string
  variant?: BrutalVariant
  target?: string
}

const { href, variant = 'primary', target } = Astro.props
---

<a
  href={href}
  target={target}
  class:list={['brutal-btn', variant === 'primary' ? 'brutal-btn-primary' : 'brutal-btn-ghost']}
>
  <slot />
</a>
