---
import Link from './Link.astro'

interface Props {
  title: string
  description?: string
  href?: string
  target?: string
}

const { title, description, href, target } = Astro.props
---

{
  href ? (
    <Link href={href} target={target} class="brutal-card-hover">
      <h3 class="mb-2 text-xl font-bold">{title}</h3>
      {description && <p class="mb-4 text-sm text-gray-700">{description}</p>}
      <slot />
    </Link>
  ) : (
    <div class="brutal-card cursor-default">
      <h3 class="mb-2 text-xl font-bold">{title}</h3>
      {description && <p class="mb-4 text-sm text-gray-700">{description}</p>}
      <slot />
    </div>
  )
}
