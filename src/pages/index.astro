---
import MainLayout from '../layouts/MainLayout.astro'
import PageHeader from '../components/core/PageHeader.astro'
import BrutalBtn from '../components/ui/BrutalBtn.astro'
import BrutalCard from '../components/ui/BrutalCard.astro'
import { REPO_URL } from '../constants'
---

<MainLayout title="Dashboard Kelas">
  <PageHeader
    title="FOUR"
    highlight="FO"
    size="hero"
    description="Ruang Kelas Teknik Komputer & Jaringan"
  >
    <div class="mt-8 flex justify-center gap-4">
      <BrutalBtn href="/about" variant="primary">Tentang</BrutalBtn>
      <BrutalBtn href={REPO_URL} variant="ghost" target="_blank"> Source Code </BrutalBtn>
    </div>
  </PageHeader>

  <section id="modules" class="grid max-w-5xl grid-cols-1 gap-6 pb-16 md:grid-cols-3">
    <BrutalCard
      title="Jadwal Pelajaran"
      description="Cek mata pelajaran yang aktif hari ini."
      href="/schedule"
    >
      <span class="underline-grow font-bold">Lihat Jadwal</span>
    </BrutalCard>

    <BrutalCard title="Galeri Kelas" description="Dokumentasi & memori kelas." href="/gallery">
      <span class="underline-grow font-bold">Buka Galeri</span>
    </BrutalCard>

    <BrutalCard title="Pesan Anonim" description="Kirim pesan rahasia." href="/messages">
      <span class="underline-grow font-bold">Kirim Pesan</span>
    </BrutalCard>
  </section>
</MainLayout>
