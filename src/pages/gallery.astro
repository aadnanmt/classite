        <div class="aspect-square bg-gray-200"></div>
        <p class="mt-3 text-sm font-medium">Belum ada foto. Santai dulu.</p>
      </div>
      <div class="shadow-brutal-md border-4 border-black bg-white p-6">
        <div class="aspect-square bg-gray-200"></div>
        <p class="mt-3 text-sm font-medium">Belum ada foto. Santai dulu.</p>
      </div>
      <div class="shadow-brutal-md border-4 border-black bg-white p-6">
        <div class="aspect-square bg-gray-200"></div>
        <p class="mt-3 text-sm font-medium">Belum ada foto. Santai dulu.</p>
      </div>
    </div>
